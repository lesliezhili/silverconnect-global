# SilverConnect Global Environment Variables
# Copy to .env.local and fill in values

# Database (Neon PostgreSQL — ap-southeast-2)
DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.ap-southeast-2.aws.neon.tech/neondb?sslmode=require

# Session
SESSION_SECRET=generate-32-char-random-string-here

# NDIS Integration
NDIS_PROVIDER_NUMBER=
NDIS_PRODA_ORG_ID=
NDIS_PRODA_API_KEY=
NDIS_ENVIRONMENT=sandbox

# TAC (Transport Accident Commission — Victoria)
TAC_PROVIDER_ID=
TAC_API_KEY=
TAC_ENVIRONMENT=sandbox

# WorkSafe Victoria
WORKSAFE_PROVIDER_ID=
WORKSAFE_API_KEY=
WORKSAFE_ENVIRONMENT=sandbox

# Azure SQL (B2B Provider Portal)
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
AZURE_SQL_USERNAME=
AZURE_SQL_PASSWORD=

# External Services
NEXT_PUBLIC_MAPBOX_TOKEN=
WEATHER_API_KEY=

# Cron Authentication
CRON_SECRET=generate-random-string-for-cron-auth

# Application
NEXT_PUBLIC_APP_URL=https://silverconnect-global.vercel.app
NEXT_PUBLIC_DEFAULT_LOCALE=en
NODE_ENV=production

# ─── Stripe (Test Mode — FREE) ──────────────────────────────
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE

# ─── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://ukgolkaejlfhcqhudmve.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage (for evidence photo uploads)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Storage provider switch (see lib/storage/gateway.ts) ───────
# "supabase" (default) or "oss" — leave unset for the AU deployment
STORAGE_PROVIDER=

# ─── Alibaba Cloud OSS (mainland China deployment only) ─────────
# See docs/CHINA_DEPLOYMENT.md — used when STORAGE_PROVIDER=oss
ALIYUN_OSS_REGION=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET_EVIDENCE=
ALIYUN_OSS_BUCKET_DOCUMENTS=
ALIYUN_OSS_CDN_DOMAIN=

# Email (SMTP - use Ethereal for dev, SendGrid/SES for prod)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SilverConnect <hello@silverconnect.app>

# Cron secret (for external auto-release trigger)
CRON_SECRET=generate-random-secret-here
